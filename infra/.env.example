# Copy to infra/.env on the VPS. Never commit the real file — compose
# reads it automatically because it lives next to docker-compose.yml.
# See docs/DEPLOYMENT.md for the full production runbook.

# Postgres — used both to start the postgres container and to build
# DATABASE_URL for api/worker/migrate inside docker-compose.yml.
POSTGRES_DB=zybrilka
POSTGRES_USER=zybrilka
POSTGRES_PASSWORD=change-me-to-a-real-secret

# Shown by GET /health and in logs — set to the deployed commit/tag.
APP_VERSION=prod

# --- Auth (S3): email magic-link + VK ID — all optional ---
# Never commit real values here or in infra/.env. Leave a variable
# blank to keep that provider off: the API answers a clear
# 'email_not_configured'/'vk_not_configured' 503 instead of pretending
# to work (see apps/api/src/modules/auth/{email,vk}.ts). Leaving them
# blank is safe — docker-compose.yml's api.environment now defaults an
# unset WEB_BASE_URL/VK_REDIRECT_URI to the values below, and
# apps/api/src/config.ts treats a blank value the same as unset for
# every other field (so this file's own blanks never crash the app).

# Public base URL the web app is served at (matches infra/caddy/Caddyfile).
# Used for the post-login VK ID / Yandex ID redirects.
WEB_BASE_URL=https://zybrilka.ru

# VK ID OAuth — enables "Войти через VK ID". Register an app at VK ID
# for Business (id.vk.ru) to get a client id/secret; VK_REDIRECT_URI
# must exactly match what's registered there.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://zybrilka.ru/api/v1/auth/vk/callback

# Yandex ID OAuth — enables «Войти через Яндекс» (docs/YANDEX_ID.md). Create
# the app at https://oauth.yandex.ru (platform «Веб-сервисы»); the Redirect
# URI there must be exactly YANDEX_REDIRECT_URI below. Leave the id/secret
# blank to keep the button off («пока не настроен»). Server-only values.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://zybrilka.ru/api/v1/auth/yandex/callback

# Telegram Mini App sign-in. The bot token comes from @BotFather and is used
# ONLY on the server (to verify the signed launch data and to fetch a profile
# photo through the Bot API). Never put it in the frontend or commit it.
# Leave empty to keep Telegram sign-in switched off. See docs/TELEGRAM_MINI_APP.md.
TELEGRAM_BOT_TOKEN=
# How old (seconds) the signed launch data may be; 60..86400.
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
# Worker: read the bot's updates (/start, buttons). Off unless set to true —
# a bot has only one update reader, so this takes updates away from any other
# service answering the bot. Notifications and broadcasts work without it.
# See docs/TELEGRAM_BOT.md.
TELEGRAM_BOT_POLLING=false

# Owner-only admin panel (docs/ADMIN.md). Comma-separated ids of existing
# `users` rows allowed into https://zybrilka.ru/admin. Empty = nobody.
# Find your id after signing in once: see docs/ADMIN.md §Назначение владельца.
ADMIN_OWNER_USER_IDS=
