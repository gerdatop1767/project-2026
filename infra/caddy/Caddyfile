# Production edge for zybrilka.ru. Caddy handles TLS certificates
# automatically (Let's Encrypt via HTTP-01/ALPN — no manual cert
# generation) and redirects HTTP -> HTTPS by default for any domain
# name listed here; nothing extra to configure for that.

# Canonicalize www -> apex, preserving path/query.
www.zybrilka.ru {
	redir https://zybrilka.ru{uri} permanent
}

zybrilka.ru {
	encode zstd gzip

	# VK ID's OAuth start/callback only ever exist at the API's real
	# (prefixed) routes — GET /api/v1/auth/vk/start and
	# GET /api/v1/auth/vk/callback (apps/api/src/modules/auth/routes.ts,
	# prefixed once in app.ts). A request to the unprefixed shape
	# (/auth/vk/start, /auth/vk/callback — e.g. VK_REDIRECT_URI set
	# without /api/v1, or anyone pasting the "obvious" short URL)
	# previously fell through to the `handle {}` block below and got
	# served the SPA's index.html instead of a redirect to VK — this
	# alias rewrites just those two exact paths to their real API
	# counterpart before proxying, so either shape reaches the same
	# single Fastify route (never two routes, and the web SPA has no
	# client-side route under /auth/* to collide with — see
	# apps/web/src/lib/routes.ts).
	@vkAuthAlias path /auth/vk/start /auth/vk/callback
	handle @vkAuthAlias {
		rewrite * /api/v1{uri}
		reverse_proxy api:3000
	}

	# The API registers its own routes at /api/v1/* and a separate
	# top-level /health (see apps/api/src/app.ts) — proxied here with
	# no path stripping, matching that layout exactly.
	@api path /api/* /health
	handle @api {
		reverse_proxy api:3000
	}

	# Everything else: the web container already handles SPA
	# client-side-route fallback (nginx `try_files ... /index.html`)
	# — this is a plain reverse proxy to it.
	handle {
		reverse_proxy web:80
	}
}
