# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

# API
HOST=127.0.0.1
PORT=3000
APP_VERSION=dev

# PostgreSQL (optional in development; required in production)
DATABASE_URL=postgres://zybrilka:zybrilka@localhost:5432/zybrilka_dev

# Where the web app is served — used to build the magic-link URL emailed
# to the user and the post-login VK OAuth redirect target.
WEB_BASE_URL=http://localhost:5173

# Email (registration, password reset, passwordless link — docs/EMAIL_AUTH.md).
# Not configured — leave unset in development to get a clear
# 'email_not_configured' error instead of a silent no-op. Never put real
# credentials in this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Zybrilka <no-reply@zybrilka.ru>

# VK ID OAuth (sign-in with VKontakte). Not configured — leave unset to
# get a clear 'vk_not_configured' error instead of a broken redirect.
# Register an app at https://id.vk.com to get a client id/secret, and set
# VK_REDIRECT_URI to this API's /api/v1/auth/vk/callback URL.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

# Telegram Mini App sign-in. Bot token from @BotFather; server-side only.
# Unset = Telegram sign-in answers 503 'telegram_not_configured'.
# See docs/TELEGRAM_MINI_APP.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600

# Owner-only admin panel (docs/ADMIN.md). Comma-separated ids of existing
# `users` rows allowed into /admin. Empty = nobody (the safe default).
ADMIN_OWNER_USER_IDS=
