# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

# API
HOST=127.0.0.1
PORT=3000
APP_VERSION=dev

# PostgreSQL (optional in development; required in production)
DATABASE_URL=postgres://zybrilka:zybrilka@localhost:5432/zybrilka_dev

# Where the web app is served — used to build the magic-link URL emailed
# to the user and the post-login VK OAuth redirect target.
WEB_BASE_URL=http://localhost:5173

# VK ID OAuth (sign-in with VKontakte). Not configured — leave unset to
# get a clear 'vk_not_configured' error instead of a broken redirect.
# Register an app at https://id.vk.com to get a client id/secret, and set
# VK_REDIRECT_URI to this API's /api/v1/auth/vk/callback URL.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

# Yandex ID OAuth («Войти через Яндекс», docs/YANDEX_ID.md). Not configured —
# leave unset and the button lands back on /login with «пока не настроен»;
# other sign-in methods keep working. For local testing register a separate
# Yandex app whose Redirect URI is http://localhost:5173/api/v1/auth/yandex/callback.
# The secret is read only by the API — never put it in web code or Git.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=

# Telegram Mini App sign-in. Bot token from @BotFather; server-side only.
# Unset = Telegram sign-in answers 503 'telegram_not_configured'.
# See docs/TELEGRAM_MINI_APP.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
# Worker: read the bot's updates (/start, buttons). Off unless set to true —
# a bot has only one update reader, so this takes updates away from any other
# service answering the bot. Notifications and broadcasts work without it.
# See docs/TELEGRAM_BOT.md.
TELEGRAM_BOT_POLLING=false

# Owner-only admin panel (docs/ADMIN.md). Comma-separated ids of existing
# `users` rows allowed into /admin. Empty = nobody (the safe default).
ADMIN_OWNER_USER_IDS=
