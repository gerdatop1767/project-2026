# Copy to .env for local development. Never commit real secrets.

# Optional. Bring the marketing landing back as the signed-out start page
# (it is always reachable at /landing). Default: the trainer opens at "/".
# VITE_LANDING_AS_HOME=true

# Optional. Deep link back into the Telegram Mini App, shown as a button on
# the /telegram-return page after a VK ID sign-in started in Telegram
# (e.g. https://t.me/<bot_username>/<app_short_name>). Without it the page
# explains in words how to switch back to Telegram.
# VITE_TELEGRAM_MINI_APP_URL=
