{
  "name": "@zybrilka/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@zybrilka/source --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "skills:sync": "tsx --conditions=@zybrilka/source --env-file-if-exists=../../.env src/scripts/syncSkills.ts",
    "skills:rebuild-stats": "tsx --conditions=@zybrilka/source --env-file-if-exists=../../.env src/scripts/rebuildAllSkillStatistics.ts",
    "tasks:rebuild-stats": "tsx --conditions=@zybrilka/source --env-file-if-exists=../../.env src/scripts/rebuildTaskStatistics.ts",
    "errors:rebuild-stats": "tsx --conditions=@zybrilka/source --env-file-if-exists=../../.env src/scripts/rebuildAllErrorStatistics.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@zybrilka/db": "workspace:*",
    "@zybrilka/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "nodemailer": "^10.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2"
  }
}
